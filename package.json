{
  "name": "spin-the-wheel",
  "version": "2.0.0",
  "description": "Could not find a decent spin the wheel website, so I vibecoded one for myself so I can offload hard decisions to luck.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "wrangler dev",
    "postinstall": "nuxt prepare",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=db/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=db/seed.sql"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KJone1/spin-the-wheel.git"
  },
  "license": "ISC",
  "dependencies": {
    "@lucide/vue": "^1.77.0",
    "nuxt": "^4.6.4",
    "reka-ui": "^2.11.0",
    "vue": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "wrangler": "^4.165.0"
  },
  "allowScripts": {
    "workerd@1.20261118.1": true
  }
}
